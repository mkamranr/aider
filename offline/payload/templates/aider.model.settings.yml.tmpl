# Aider model settings for the LAN vLLM server - generated by install.ps1
# Location: %USERPROFILE%\.aider.model.settings.yml
#
# WHY THIS FILE IS REQUIRED
# Aider picks settings by substring-matching the model name. A vLLM model name
# matches nothing, so without this file you silently get the unknown-model
# defaults: edit_format "whole" and use_repo_map false, which is aider's worst
# mode. An EXACT name match here skips all substring heuristics
# (aider/models.py), so this entry is fully authoritative.
#
# The `name` must equal exactly what aider passes to litellm, i.e.
#   openai/<the value of vLLM --served-model-name>
#
# CAUTION: aider splats this dict straight into ModelSettings(**d). Any key
# that is not a ModelSettings field is a FATAL startup error. verify.ps1
# check 4 catches that before you hit it interactively.
#
# Must stay UTF-8 WITHOUT BOM and 7-bit ASCII.

- name: __FULL_MODEL__
  # SEARCH/REPLACE blocks. Chosen over "whole" because with a capped output
  # budget "whole" can silently truncate a large file mid-rewrite, which is
  # data loss; a diff failure is loud and aider retries. Chosen over "udiff"
  # because exact hunk line accounting is the most brittle thing you can ask
  # of a sub-70B open-weights model. Downgrade to "whole" for models under
  # roughly 14B.
  edit_format: __EDIT_FORMAT__
  editor_edit_format: __EDITOR_EDIT_FORMAT__
  # There is no cheap second model on a single vLLM server. Pointing these at
  # the same name makes aider reuse the SAME Model object rather than
  # constructing another one, so there is no second metadata lookup and no
  # second chance to fall through to the network.
  weak_model_name: __FULL_MODEL__
  editor_model_name: __FULL_MODEL__
  # The whole point of overriding the unknown-model default.
  use_repo_map: true
  # true means temperature 0. Greedy decoding is correct for SEARCH/REPLACE,
  # where the model must reproduce existing source lines byte for byte.
  # For a reasoning model (QwQ, R1 distills, Qwen3 thinking) use 0.6 instead:
  # temperature 0 sends those into repetition loops.
  use_temperature: __USE_TEMPERATURE__
  streaming: true
  examples_as_sys_msg: false
  use_system_prompt: true
  cache_control: false
  caches_by_default: false
  lazy: false
  overeager: false
  reminder: user
__REASONING_BLOCK__  extra_params:
    # AUTHORITATIVE endpoint. This becomes a direct litellm.completion kwarg,
    # which outranks OPENAI_BASE_URL / OPENAI_API_BASE. It is the only setting
    # that survives opening a cloned repo whose own .env sets
    # OPENAI_API_BASE=https://api.openai.com/v1 (repo .env loads after the
    # home one with override=True).
    api_base: "__VLLM_BASE__"
    api_key: "__API_KEY__"
    # vLLM rejects prompt_tokens + max_tokens > --max-model-len with a 400,
    # not a truncation. This value and max_input_tokens in
    # .aider.model.metadata.json are derived together to stay under budget.
    max_tokens: __MAX_OUTPUT__

# Safety net: pins the endpoint for EVERY model name, including one typed by
# mistake on the command line. Deep-merged over the per-model extra_params, so
# it wins on key collisions. Harmless here because there is exactly one
# reachable endpoint; `aider --model openai/typo` now fails with a clean vLLM
# 404 instead of reaching for api.openai.com.
- name: aider/extra_params
  extra_params:
    api_base: "__VLLM_BASE__"
    api_key: "__API_KEY__"
