// Aider model metadata for the LAN vLLM server - generated by install.ps1
// Location: %USERPROFILE%\.aider.model.metadata.json
// Parsed with json5, so these comments are legal.
//
// WHY THIS FILE IS REQUIRED
// ModelInfoManager checks this local metadata FIRST and returns immediately,
// so an exact key here means aider never reaches _update_cache() and its
// requests.get() to raw.githubusercontent.com. Without it you get the
// "Unknown context window size and costs" warning, a chat history budget that
// collapses to 1024 tokens, a 1024-token repo map, and a browser prompt that
// auto-accepts under --yes.
//
// Keys must match Model.name EXACTLY, including the openai/ prefix. There is
// no partial matching for three-segment names like openai/Org/Model.
//
// Must stay UTF-8 WITHOUT BOM and 7-bit ASCII.
{
    // Primary key: exactly what aider passes to litellm.
    "__FULL_MODEL__": {
        "max_tokens": __MAX_OUTPUT__,
        "max_input_tokens": __MAX_INPUT__,
        "max_output_tokens": __MAX_OUTPUT__,
        "input_cost_per_token": 0,
        "output_cost_per_token": 0,
        "litellm_provider": "openai",
        "mode": "chat"
    },

    // Alias without the provider prefix, so --weak-model or --editor-model
    // typed bare also resolves offline.
    "__BARE_MODEL__": {
        "max_tokens": __MAX_OUTPUT__,
        "max_input_tokens": __MAX_INPUT__,
        "max_output_tokens": __MAX_OUTPUT__,
        "input_cost_per_token": 0,
        "output_cost_per_token": 0,
        "litellm_provider": "openai",
        "mode": "chat"
    }
}
