@echo off
REM Aider launcher - generated by install.ps1. Do not edit; re-run the installer.
setlocal
set "AIDER_HOME=__INSTALL_DIR__"

REM litellm ships the tiktoken BPE blobs inside its own package and points
REM TIKTOKEN_CACHE_DIR there at import time, so nothing is fetched from
REM openaipublic.blob.core.windows.net. Left unset on purpose.

REM Offline hygiene that is not model configuration.
set "LITELLM_LOCAL_MODEL_COST_MAP=True"
set "HF_HUB_OFFLINE=1"
set "HF_HUB_DISABLE_TELEMETRY=1"
REM Stops a stray %APPDATA%\Python\PythonXY\site-packages from shadowing the
REM venv. This machine class often has a user-site aider already installed.
set "PYTHONNOUSERSITE=1"
if not defined AIDER_ANALYTICS set "AIDER_ANALYTICS=false"

REM Endpoint and model settings live in %USERPROFILE%\.aider.conf.yml,
REM .aider.model.settings.yml, .aider.model.metadata.json and .env.
"%AIDER_HOME%\venv\Scripts\aider.exe" %*
exit /b %ERRORLEVEL%
