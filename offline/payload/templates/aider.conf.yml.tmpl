# Aider air-gap configuration - generated by install.ps1
# Location: %USERPROFILE%\.aider.conf.yml
#
# LOWEST precedence of the three config sources. Environment variables from
# ~/.env and any repo-local .aider.conf.yml both override this file, which is
# deliberate: a project can still pin its own model.
#
# Must stay UTF-8 WITHOUT BOM and 7-bit ASCII.

model: __FULL_MODEL__

# Only these secret-ish keys are accepted in a YAML config file. They are
# written into os.environ after .env is loaded (aider/main.py), so they also
# repair the case where a cloned repo's .env sets a raw OPENAI_API_BASE.
openai-api-base: __VLLM_BASE__
openai-api-key: __API_KEY__

# Network hardening, mirrored from ~/.env so this file alone is still safe if
# the .env is lost or a repo-level .env shadows it.
check-update: false
show-release-notes: false
analytics: false
detect-urls: false
disable-playwright: true

# Behaviour
stream: true
# Aider's prompt caching emits Anthropic-style cache_control blocks. vLLM does
# prefix caching server-side (--enable-prefix-caching); sending cache_control
# risks a 400 from its strict request model.
cache-prompts: false
auto-commits: true
gitignore: true
# Left ON deliberately: with correct metadata and a key, sanity_check_model
# produces nothing. If it ever fires, it is telling you the metadata file
# stopped matching the served model name.
show-model-warnings: true
