# Aider air-gap runtime environment - generated by install.ps1
# Location: %USERPROFILE%\.env
#
# DO NOT EDIT BY HAND unless you keep this file UTF-8 WITHOUT BOM and 7-bit
# ASCII. python-dotenv has no BOM handling, so a BOM turns the first key into
# a stray-prefixed AIDER_CHECK_UPDATE and it is silently ignored.
#
# To change the endpoint or model, re-run install.ps1 with the new values.
# It regenerates all four config files and backs up the previous ones.

# --- vLLM endpoint ---------------------------------------------------------
# Belt-and-braces. The authoritative endpoint is extra_params.api_base in
# .aider.model.settings.yml, which cannot be overridden by a repo-level .env.
OPENAI_API_BASE=__VLLM_BASE__
OPENAI_BASE_URL=__VLLM_BASE__
# Must be NON-EMPTY. An empty Bearer is rejected by vLLM when it was started
# with --api-key, and aider's fast_validate_environment() keys off this var to
# avoid importing litellm during Model.__init__.
OPENAI_API_KEY=__API_KEY__

# --- Aider network touchpoints ---------------------------------------------
# versioncheck.py calls requests.get("https://pypi.org/pypi/aider-chat/json")
# with NO timeout. Air-gapped, that blocks for the full OS TCP/DNS timeout.
AIDER_CHECK_UPDATE=false
# main.py offers the release-notes URL on the first run of a new version, and
# io.offer_url auto-answers "yes" under --yes, which launches a browser.
AIDER_SHOW_RELEASE_NOTES=false
# Kills the PostHog opt-in prompt and the client construction.
AIDER_ANALYTICS=false
# Stops a URL in a prompt from offering /web, which calls
# pypandoc.download_pandoc() without prompting.
AIDER_DETECT_URLS=false
AIDER_DISABLE_PLAYWRIGHT=true

# --- litellm ---------------------------------------------------------------
# Without this, `import litellm` does httpx.get(model cost map, timeout=5).
LITELLM_LOCAL_MODEL_COST_MAP=True

# --- HuggingFace stack -----------------------------------------------------
# litellm substring-matches "llama-2" / "llama-3" in the model name and tries
# Tokenizer.from_pretrained against the Hub. HF_HUB_OFFLINE makes that fail
# fast; HF_ENDPOINT pointed at a closed local port guarantees ECONNREFUSED in
# microseconds rather than a DNS timeout if the Rust path ignores it.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
HF_ENDPOINT=http://127.0.0.1:1

# --- Proxy neutralisation --------------------------------------------------
# Corporate images often still carry HTTPS_PROXY. Without this, every call to
# the LAN vLLM host is routed at an unreachable proxy.
HTTP_PROXY=
HTTPS_PROXY=
http_proxy=
https_proxy=
NO_PROXY=*
no_proxy=*
